# =============================================================================
# Credit Risk Classification — .gitignore
# =============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ── Virtual Environments ─────────────────────────────────────────────────────
venv/
env/
.venv/
.env/
ENV/
.venv*/
venv*/

# ── Distribution / Packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
*.whl

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.suo
*.user

# ── OS Files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Secrets / Environment Variables ──────────────────────────────────────────
.env
*.env
.env.*
!.env.example
secrets.py
local_settings.py
config.local.py

# ── Dataset (downloaded at training time) ─────────────────────────────────────
data/german_credit.csv
data/*.csv
data/*.data

# ── Flask / SQLite Runtime Files ──────────────────────────────────────────────
instance/
*.sqlite3
*.sqlite
*.db
flask_session/

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Pytest / Testing ──────────────────────────────────────────────────────────
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover
.tox/
.nox/

# ── Type Checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.pytype/
.pyre/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
log/

# ── Temporary Files ───────────────────────────────────────────────────────────
*.tmp
*.bak
*.swp
*.orig

# ── Docker ───────────────────────────────────────────────────────────────────
# (Docker files ARE committed — only ignore local override files)
docker-compose.override.yml

# ── Model artifacts ───────────────────────────────────────────────────────────
# Uncomment the lines below if you use Git LFS or external artifact storage
# and do NOT want to commit model files to the repo.
# models/*.joblib
